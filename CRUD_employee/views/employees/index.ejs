<%- include('../partials/header') %>

<h1 class="mb-4">Employee List</h1>

<% if (employees.length > 0) { %>
  <div class="table-responsive">
    <table class="table table-striped table-hover">
      <thead>
        <tr>
          <th>Name</th>
          <th>Address</th>
          <th>Salary</th>
          <th>Gender</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% employees.forEach(employee => { %>
          <tr>
            <td><%= employee.name %></td>
            <td><%= employee.address %></td>
            <td>EGP <%= employee.salary %></td>
            <td><%= employee.gender %></td>
            <td>
              <a href="/employees/<%= employee._id %>/edit" class="btn btn-sm btn-warning">Edit</a>
              <form action="/employees/<%= employee._id %>/delete" method="POST" class="d-inline">
                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this employee?')">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } else { %>
  <div class="alert alert-info">No employees found. <a href="/employees/new">Add one now</a>.</div>
<% } %>

<a href="/employees/new" class="btn btn-primary mt-3">Add New Employee</a>

<%- include('../partials/footer') %>
