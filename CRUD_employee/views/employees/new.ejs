<%- include('../partials/header') %>

<div class="container">
  <h2 class="mb-4">Add New Employee</h2>
  <form method="POST" action="/employees">
    
    <div class="mb-3">
      <label class="form-label">Name</label>
      <input name="name" class="form-control form-control-lg" required>
    </div>

    <div class="mb-3">
      <label class="form-label">Address</label>
      <input name="address" class="form-control form-control-lg" required>
    </div>

    <div class="mb-3">
      <label class="form-label">Salary</label>
      <input name="salary" type="number" class="form-control form-control-lg" required>
    </div>

    <div class="mb-3">
      <label class="form-label">Gender</label>
      <select name="gender" class="form-select form-select-lg" required>
        <option value="">Select Gender</option>
        <option>Male</option>
        <option>Female</option>
      </select>
    </div>

    <button type="submit" class="btn btn-primary btn-lg mt-3">Add</button>
  </form>
</div>

<%- include('../partials/footer') %>
